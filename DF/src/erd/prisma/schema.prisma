datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas = ["ct003_cg", "ct003_tg1"]
}

generator client {
provider = "prisma-client-js"
previewFeatures = ["multiSchema"]
}

model customers {
id  Int @id @default(autoincrement())
customer_code  String? @unique
customer_name  String? 
email  String? 
phone  String? 
credit_limit  Int? 
is_active  Boolean? 
v_no  Int? 
trs_creator_email    String?
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?

@@schema("ct003_tg1")
}

model products {
id  Int @id @default(autoincrement())
product_code  String? @unique
product_name  String? 
category  String? 
unit_price  Int? 
stock_qty  Int? 
is_active  Boolean? 
v_no  Int? 
trs_creator_email    String?
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?

@@schema("ct003_tg1")
}

model orders {
id  Int @id @default(autoincrement())
order_no  String? @unique
customer_id  Int? 
order_date  DateTime? 
total_amount  Int? 
notes  String? 
is_active  Boolean? 
v_no  Int? 
trs_creator_email    String?
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?
order_items   order_items[]    

@@schema("ct003_tg1")
}

model order_items {
order_id  Int @id @default(autoincrement())
product_id  BigInt? 
product_name  String? 
quantity  Int? 
unit_price  Int? 
line_total  Int? 
is_active  Boolean? 
v_no  Int? 
trs_creator_email    String?
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?
id Int? 
orders   orders?  @relation(fields: [id], references: [id])  

@@schema("ct003_tg1")
}

model vgph_system_setup {
vgph_id  Int @id @default(autoincrement())
setup_code  String? 
product_code  String? 
interface_product  String? 
category  String? 
sub_category  String? 
purpose  String? 
setup_value  Json? 
trs_creator_email    String?
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?

@@schema("ct003_cg")  
}

model user {
id  Int @id @default(autoincrement())
username  String? 
debtoracc  String? 
creditoracc  String? 
bank  String? 
account  Int? 
trs_creator_email    String?
trs_created_date    DateTime     @default(now())  
trs_created_by    String?       
trs_modified_date    DateTime     @updatedAt  
trs_modified_by    String?       
trs_status    String?    
trs_next_status    String?    
trs_process_id    String? 
trs_access_profile    String?
trs_org_grp_code    String?
trs_org_code    String?
trs_role_grp_code    String?
trs_role_code    String?
trs_ps_grp_code    String?
trs_ps_code    String?  
trs_sub_org_grp_code    String?
trs_sub_org_code    String?

@@schema("ct003_tg1")
}







